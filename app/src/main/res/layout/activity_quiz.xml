<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <RelativeLayout
        xmlns:tools="http://schemas.android.com/tools"
        android:id="@+id/relativeLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E0F7FA"
        tools:context=".QuizActivity">

        <!-- Quiz Title -->
        <TextView
            android:id="@+id/quizTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/factors_quiz"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#1A237E"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="16dp" />

        <!-- Progress Indicator -->
        <TextView
            android:id="@+id/Progress_indicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/question_1_of_40"
            android:textSize="16sp"
            android:textColor="#757575"
            android:layout_below="@id/quizTitle"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="8dp" />

        <!-- Question Text -->
        <TextView
            android:id="@+id/Question"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/what_is_the_factor_of_12"
            android:textSize="18sp"
            android:textColor="#000000"
            android:layout_below="@id/Progress_indicator"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="16dp" />

        <!-- Options Section -->
        <RadioGroup
            android:id="@+id/radioGroupOptions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_below="@id/Question"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="16dp">

            <RadioButton
                android:id="@+id/radioOption1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/option_1"
                android:textSize="16sp"
                android:textColor="#424242" />

            <RadioButton
                android:id="@+id/radioOption2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/option_2"
                android:textSize="16sp"
                android:textColor="#424242" />

            <RadioButton
                android:id="@+id/radioOption3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/option_3"
                android:textSize="16sp"
                android:textColor="#424242" />

            <RadioButton
                android:id="@+id/radioOption4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/option_4"
                android:textSize="16sp"
                android:textColor="#424242" />
        </RadioGroup>

        <!-- Next/Submit Button -->
        <Button
            android:id="@+id/btnNext"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/next_btn"
            android:textColor="#FFFFFF"
            android:backgroundTint="#42A5F5"
            android:layout_below="@id/radioGroupOptions"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="24dp" />


        <!-- Result Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="8dp"
            android:visibility="gone"
            android:padding="16dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">

                <!-- Added heading for score -->
                <TextView
                    android:id="@+id/tvScoreHeading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Score"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:layout_gravity="center"
                    android:layout_marginBottom="16dp" />

                <!-- Existing score TextView -->
                <TextView
                    android:id="@+id/tvResult"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/black" />

                <!-- Feedback message -->
                <TextView
                    android:id="@+id/tvMessage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="18sp"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/gray" />

                <!-- Added spacing for "Finish" button -->
                <Button
                    android:id="@+id/btnFinish"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Finish"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#42A5F5"
                    android:layout_marginTop="24dp"
                    android:visibility="gone"
                    android:layout_gravity="center"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

<!--        &lt;!&ndash; Spacer for proper spacing &ndash;&gt;-->
<!--        <Space-->
<!--            android:id="@+id/spaceBetween"-->
<!--            android:layout_width="wrap_content"-->
<!--            android:layout_height="24dp"-->
<!--            android:layout_below="@id/cardResult"-->
<!--            android:layout_centerHorizontal="true"/>-->

    </RelativeLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
