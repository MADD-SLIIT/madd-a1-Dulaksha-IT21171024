<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E0F7FA"
    tools:context=".DashboardActivity">

    <!-- ScrollView for the main content -->
    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginBottom="56dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/bottomNavigation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Header TextView -->
        <TextView
            android:id="@+id/KnowledgeHubDash"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/appName"
            android:textSize="24sp"
            android:textColor="@color/blue2"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Search Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardSearch"
            android:layout_width="0dp"
            android:layout_height="150dp"
            android:layout_margin="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="8dp"
            app:layout_constraintTop_toBottomOf="@id/KnowledgeHubDash"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="16dp"
                android:gravity="center">

                <TextView
                    android:id="@+id/TxtStartLearning"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/start_learning"
                    android:textSize="22sp"
                    android:textColor="@color/blue2"
                    android:textStyle="bold" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/search_bar_background">

                    <!-- Search Icon -->
                    <ImageView
                        android:id="@+id/searchIcon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="8dp"
                        android:layout_gravity="center_vertical"
                        android:src="@drawable/search_img"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                    <!-- Search Bar -->
                    <EditText
                        android:id="@+id/searchBar"
                        android:layout_width="0dp"
                        android:layout_marginStart="36dp"
                        android:layout_height="50dp"
                        android:layout_gravity="center_vertical"
                        android:hint="@string/search_hint"
                        android:background="@android:color/transparent"
                        android:paddingStart="8dp"
                        android:textColor="@color/black"
                        android:textColorHint="@color/gray"
                        app:layout_constraintStart_toEndOf="@id/searchIcon"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Mathematics Subject Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardMathematics"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginHorizontal="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="8dp"
            app:layout_constraintTop_toBottomOf="@id/cardSearch"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/TxtMathematics"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/mathematics_txt"
                    android:textColor="@color/black"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/MathematicsDesc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/Maths_Des"
                    android:textColor="@color/gray"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/btnEnroll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="@color/blue3"
                    android:text="@string/enroll_btn"
                    android:textColor="@color/white" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Science Subject Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardScience"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginHorizontal="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="8dp"
            app:layout_constraintTop_toBottomOf="@id/cardMathematics"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/TxtScience"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/Science_Txt"
                    android:textSize="18sp"
                    android:textColor="@color/black"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvScienceDesc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/Science_Des"
                    android:textSize="14sp"
                    android:textColor="@color/gray" />

                <Button
                    android:id="@+id/btnEnrollScience"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/enroll_btn"
                    android:textColor="@color/white"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="@color/blue3" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- English Subject Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardEnglish"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginHorizontal="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="8dp"
            app:layout_constraintTop_toBottomOf="@id/cardScience"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/TxtEnglish"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/english_txt"
                    android:textSize="18sp"
                    android:textColor="@color/black"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvEnglishDesc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/English_Des"
                    android:textSize="14sp"
                    android:textColor="@color/gray" />

                <Button
                    android:id="@+id/btnEnrollEnglish"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/enroll_btn"
                    android:textColor="@color/white"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="@color/blue3" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Sinhala Subject Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardSinhala"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginHorizontal="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="8dp"
            app:layout_constraintTop_toBottomOf="@id/cardEnglish"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/TxtSinhala"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sinhala_txt"
                    android:textSize="18sp"
                    android:textColor="@color/black"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSinhalaDesc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/Sinhala_Des"
                    android:textSize="14sp"
                    android:textColor="@color/gray" />

                <Button
                    android:id="@+id/btnEnrollSinhala"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/enroll_btn"
                    android:textColor="@color/white"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="@color/blue3" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>

    <!-- Bottom Navigation -->
<LinearLayout
android:id="@+id/bottomNavigation"
android:layout_width="match_parent"
android:layout_height="56dp"
android:orientation="horizontal"
android:background="@color/white"
app:layout_constraintBottom_toBottomOf="parent">

<ImageView
    android:id="@+id/logout"
    android:layout_width="40dp"
    android:layout_height="40dp"
    android:layout_weight="1"
    android:src="@drawable/logout"
    android:contentDescription="Logout"
    android:layout_gravity="center" />

<ImageView
    android:id="@+id/navHome"
    android:layout_width="30dp"
    android:layout_height="30dp"
    android:layout_weight="1"
    android:src="@drawable/dashboard_icon"
    android:contentDescription="Notifications"
    android:layout_gravity="center" />

<ImageView
    android:id="@+id/navProfile"
    android:layout_width="30dp"
    android:layout_height="30dp"
    android:layout_weight="1"
    android:src="@drawable/profile_icon"
    android:contentDescription="Profile"
    android:layout_gravity="center" />
</LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
